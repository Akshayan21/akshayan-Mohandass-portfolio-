---
import { html } from '../lib/content';
interface Props { cards:{title:string;body:string}[]; themes?:string[]; label?:string; nextLink?:string; prefix?:string }
const {cards,themes=['Clarity','Evidence','Mobile','Enquiry'],label='What your website needs to do',nextLink='#included',prefix='principles'}=Astro.props;
---
<div class="benefit-sequence" data-benefit-sequence={prefix}>
  <div class="benefit-controls"><span>{label}</span><div class="benefit-progress" aria-hidden="true"><span /></div><button type="button" data-benefit-prev aria-label="Previous panel">←</button><button type="button" data-benefit-next aria-label="Next panel">→</button><a href={nextLink}>Continue below ↓</a></div>
  <div class="benefit-viewport"><div class="benefit-track">{cards.map((card,i)=><article class={`benefit-card benefit-tone-${i}`} tabindex="0" aria-labelledby={`${prefix}-title-${i}`}><div><span class="benefit-theme" aria-hidden="true">{themes[i]}</span><h3 id={`${prefix}-title-${i}`}>{card.title}</h3></div><div class="prose" set:html={html(card.body)} /></article>)}</div></div>
</div>
