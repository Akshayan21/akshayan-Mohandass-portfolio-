---
import Enquiry from './Enquiry.astro';
import { html } from '../lib/content';
interface Props { body: string }
const {body}=Astro.props;
const introduction=body.split('### Project enquiry')[0].split('**Email:**')[0].trim();
---
<div class="contact-grid editorial-contact">
  <aside class="contact-introduction">
    <div class="contact-direction" aria-hidden="true"><svg viewBox="0 0 80 80" fill="none"><path d="M15 15 65 65M15 65h50V15" stroke="currentColor" stroke-width="3"/></svg></div>
    <div class="prose" set:html={html(introduction)} />
    <div class="contact-email"><p>Prefer email?</p><a href="mailto:akshayanmohandass@gmail.com">akshayanmohandass<wbr />@gmail.com <span aria-hidden="true">↗</span></a><span>Work directly with Akshayan Mohandass.</span></div>
  </aside>
  <Enquiry />
</div>
